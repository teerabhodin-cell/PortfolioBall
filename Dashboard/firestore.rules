rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The only Firebase Authentication UID allowed to administer this dashboard.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'GsM7MmhIu1PXb1zURIpNnYXuXPG2';
    }

    // Public visitors may read just the portfolio metadata and public dashboard data.
    // Only the signed-in admin may create/edit portfolio metadata and private/audit data.
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /public/{documentId} {
        allow read: if true;
        allow write: if false;

        match /{subcollection}/{documentId} {
          allow read: if true;
          allow write: if false;
        }
      }

      match /private/{documentId} {
        allow read, write: if isAdmin();

        match /{subcollection}/{documentId} {
          allow read, write: if isAdmin();
        }
      }

      match /auditLogs/{auditId} {
        allow read, write: if isAdmin();
      }
    }

    // Default deny: blocks all undeclared collections and documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
